# Old WordPress addresses -> matching sections of the new single-page site.
# First matching rule wins. Existing files are never overridden.

# Old WordPress query-string addresses (?p=, ?page_id=, ?post_type=).
# The old site was hacked and thousands of spam posts lived at these
# addresses. Netlify ignores query strings when serving files, so without
# these rules they load the home page. Answer "not found" instead, so
# Google drops them.
/  p=:p                  /404.html    404!
/  page_id=:id           /404.html    404!
/  post_type=:type       /404.html    404!

# Suite pages are built from data/suites.json (scripts/build.mjs). A suite
# that has been removed has no page, so its address gets the "this suite has
# been rented" page with a 404, and Google drops it.
/suites                     /#suites                   301
/suites/*                   /suite-unavailable.html    404

# Old WordPress unit pages (/properties/unit-303-2-bedroom etc.) are gone too.
/properties                 /#suites                   301
/properties/*               /suite-unavailable.html    404

/gallery                    /#building   301
/gallery/*                  /#building   301
/registration               /#contact    301
/registration/*             /#contact    301
/features/coin-laundry      /#included   301
/features/coin-laundry/*    /#included   301
/features                   /#features   301
/features/*                 /#features   301

# Any other address that doesn't exist gets 404.html automatically.
